{
  "name": "zod-to-swift",
  "version": "0.1.2",
  "description": "Zod schemas → Swift Codable value types: enums that survive new values, discriminated unions as exhaustive enums, explicit null encoding.",
  "license": "MIT",
  "author": "Sam Gluck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdgluck/zod-to-swift.git"
  },
  "keywords": [
    "zod",
    "codegen",
    "json-schema",
    "swift",
    "codable",
    "ios"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'"
  },
  "peerDependencies": {
    "zod": "^4.3.6",
    "zod-native-ir": "github:sdgluck/zod-native-ir#v0.1.2"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "typescript": "^7.0.2",
    "zod": "^4.3.6",
    "zod-native-ir": "github:sdgluck/zod-native-ir#v0.1.2"
  }
}
